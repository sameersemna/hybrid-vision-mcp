# ============================================
# Hybrid Vision MCP Server — Environment Config
# ============================================
# Copy this file to .env and adjust values.
#   cp .env.example .env
# The server loads .env automatically when present.
# ============================================

# --- Server ---
# Port the Express listener binds to.
PORT=11402

# --- Ollama ---
# Base URL for the local Ollama inference service.
OLLAMA_HOST=http://localhost:11434
# Timeout for Ollama vision requests in milliseconds.
OLLAMA_TIMEOUT_MS=180000
# Maximum number of Ollama vision requests allowed to run concurrently. Vision models are
# GPU/unified-memory bound; running several in parallel has been observed to crash the host.
# Extra requests queue in-process instead of hitting Ollama simultaneously. Raise only if the
# host has confirmed headroom for concurrent vision inference.
MAX_PARALLEL_OLLAMA_REQUESTS=1
# Maximum number of requests allowed to wait in the Ollama queue before new ones are rejected
# outright (fails fast instead of piling up indefinitely under a burst of clients).
MAX_OLLAMA_QUEUE_SIZE=20

# --- MCP Protocol ---
# Timeout for MCP client request/response in milliseconds.
# Heavy vision tools (analyze_image, browser_screenshot_analysis, detect_ui_elements,
# find_text_element, compare_images) may exceed the default 60s SDK timeout.
# Set this to match or exceed OLLAMA_TIMEOUT_MS.
MCP_REQUEST_TIMEOUT_MS=300000

# --- Vision Models ---
# Default fast vision model (used by analyze_image, detect_ui_elements).
VISION_MODEL_FAST=llava:13b
# Default heavy vision model (used by find_text_element, compare_images,
# browser_screenshot_analysis, visual_diff).
VISION_MODEL_HEAVY=qwen3-vl:30b

# --- Storage Directories ---
# Directory for temporary binary image uploads.
UPLOAD_DIR=/tmp/hvm-uploads
# Directory for saved output images (annotations, diffs, overlays).
FEEDBACK_DIR=/tmp/hvm-feedback
# Directory for downloaded images from URLs (via download_image tool or transparent URL resolution).
DOWNLOAD_DIR=./tmp/hvm-downloads

# --- Upload Security ---
# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=20
# Maximum download size in megabytes (for URL-based image downloads).
MAX_DOWNLOAD_SIZE_MB=50
# Maximum upload requests per minute per client IP.
UPLOAD_RATE_LIMIT=10
# Comma-separated list of allowed CORS origins for /upload.
# Leave empty to allow all origins.
CORS_ORIGINS=

# --- generate_repo_graph Security ---
# Comma-separated list of absolute directory paths that generate_repo_graph is
# permitted to walk. Prevents unauthenticated network clients from enumerating the
# entire host filesystem. Defaults to the server's own project directory.
ALLOWED_REPO_ROOTS=
